rules_version = '2';
// Combined rules: AlpArcade, Seeking Biblical Truth, shared feedback, and DCA Lab journals.
// Deploy from portfolio root:
//   npx firebase-tools deploy --only firestore:rules
//
// CRITICAL: path wildcards (e.g. scoreId) MUST be passed into functions.
// Using scoreId inside a top-level function without an argument evaluates false
// → permanent permission-denied even when auth is fine.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.uid is string;
    }

    // Keep in sync with pages/seeking-biblical-truth/js/firebase-config.js allowedEmails
    function isVaultEditor() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'alphaolivegreen@gmail.com'
        ];
    }

    function validGame(g) {
      return g in ['tictactoe', 'shooter', 'snake', 'reaction', 'memory', 'tapper', 'jubeat', 'breaker'];
    }

    function validFeedbackProject(project) {
      return project in [
        'Portfolio',
        'Conviction',
        'Seeking Biblical Truth',
        'KoboForge',
        'AlpArcade',
        'VerseKeep',
        'ChristoDay',
        'CardFitSG'
      ];
    }

    function validFeedbackType(feedbackType) {
      return feedbackType in ['Bug', 'Suggestion', 'Design', 'Content', 'Accessibility', 'Other'];
    }

    function validFeedbackCreate() {
      let d = request.resource.data;
      return d.keys().hasAll([
          'schema',
          'project',
          'type',
          'rating',
          'message',
          'contact',
          'sourceUrl',
          'submittedAt'
        ])
        && d.keys().hasOnly([
          'schema',
          'project',
          'type',
          'rating',
          'message',
          'contact',
          'sourceUrl',
          'submittedAt'
        ])
        && d.schema is int
        && d.schema == 1
        && d.project is string
        && validFeedbackProject(d.project)
        && d.type is string
        && validFeedbackType(d.type)
        && d.rating is int
        && d.rating >= 0
        && d.rating <= 5
        && d.message is string
        && d.message.size() >= 10
        && d.message.size() <= 4000
        && d.contact is string
        && d.contact.size() <= 254
        && d.sourceUrl is string
        && d.sourceUrl.size() >= 1
        && d.sourceUrl.size() <= 1000
        && d.submittedAt is timestamp
        && d.submittedAt == request.time;
    }

    function validScoreWrite(scoreId) {
      let d = request.resource.data;
      return signedIn()
        && d.userId is string
        && d.userId == request.auth.uid
        && d.game is string
        && validGame(d.game)
        && scoreId == request.auth.uid + '_' + d.game
        && d.playerName is string
        && d.playerName.size() >= 1
        && d.playerName.size() <= 16
        && d.score is number
        && d.score >= 0
        && d.score <= 1000000
        && ((d.game != 'shooter' && d.game != 'breaker') || d.score <= 25000)
        && ((d.game != 'snake' && d.game != 'tapper') || d.score <= 8000)
        && d.rankScore is number;
    }

    match /scores/{scoreId} {
      allow read: if true;

      allow create: if validScoreWrite(scoreId);

      allow update: if validScoreWrite(scoreId)
        && resource.data.userId == request.auth.uid;

      // Owner may delete own leaderboard row (factory reset / clean slate)
      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid;
    }

    match /players/{uid} {
      allow read: if true;

      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.username is string
        && request.resource.data.username.size() >= 1
        && request.resource.data.username.size() <= 16;

      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // AlpArcade full account progress — owner only
    match /progress/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;

      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.userId == request.auth.uid;

      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /vaultNotes/{noteId} {
      allow read: if true;

      allow create, update: if isVaultEditor()
        && request.resource.data.path is string
        && request.resource.data.path.size() > 0
        && request.resource.data.path.size() < 500
        && request.resource.data.content is string
        && request.resource.data.content.size() < 1000000
        && request.resource.data.updatedBy == request.auth.token.email
        && request.resource.data.updatedByUid == request.auth.uid;

      allow delete: if isVaultEditor();
    }

    // Anyone may submit a tightly validated entry. Only the owner can review
    // or change inbox contents from an authenticated client.
    match /feedback/{feedbackId} {
      allow create: if validFeedbackCreate();
      allow read, update, delete: if isVaultEditor();
    }

    // Conviction DCA Lab journal. Private per Google account; not publicly readable.
    // Pass uid in — path wildcards are invisible inside top-level functions.
    function validDcaJournal(uid) {
      let d = request.resource.data;
      return signedIn()
        && request.auth.uid == uid
        && d.userId == request.auth.uid
        && d.schema is int
        && d.schema == 1
        && d.settings is map
        && d.months is map
        && d.ledger is list
        && d.ledger.size() <= 10000
        && d.updatedMs is number
        && d.updatedAt is timestamp;
    }

    match /dcaJournals/{uid} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if validDcaJournal(uid);
    }
  }
}
