data/Networth Tracker.xlsx
*.xlsx

# Firebase CLI cache
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log
*.log
*-firebase-adminsdk-*.json
serviceAccount*.json
.env
.env.*

# Python
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.pyc

# Test-only dependencies and browser artifacts (the deployed site remains zero-build)
node_modules/
playwright-report/
test-results/

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*~

# Seeking Biblical Truth integration
# The committed public viewer lives in `pages/seeking-biblical-truth/` and is
# generated from the separate source vault repo. Do not clone the full vault into
# this repository.
seeking-biblical-truth/*
!seeking-biblical-truth/index.html

# Obsidian vault caches & volatile files (large or session-specific; exclude even if folder present)
**/.obsidian/workspace.json
**/.obsidian/workspace*
**/.obsidian/cache/
**/.obsidian/trash/
**/.obsidian/backup/
**/.obsidian/log/
*.obsidian.log
